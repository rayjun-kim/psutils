    <definitions>
      <definition>
        <class_type>TRANSFORM_CLASS</class_type>
        <class_name>Processor</class_name>
        <class_source>
public boolean processRow() throws HopException
{
  Object[] r = getRow();
  if (r == null) {
    setOutputDone();
    return false;
  }

  boolean failFast = Boolean.parseBoolean(getVariable("FAIL_FAST", "true"));

  String tableName = "(unknown)";
  try {
    // PipelineExecutor's output row only carries the Execution* result
    // fields, not the original TABLE_NAME - recover it from the
    // captured sub-pipeline log text instead (used for logging only).
    // Only Basic-level messages are guaranteed to be present here, so
    // match against our own logBasic/logError lines rather than Hop's
    // internal Detailed-level "SQL query" trace.
    int logIdx = getInputRowMeta().indexOfValue("ExecutionLogText");
    if (logIdx &gt;= 0 &amp;&amp; r[logIdx] != null) {
      String logText = String.valueOf(r[logIdx]);
      java.util.regex.Matcher m = java.util.regex.Pattern.compile("edbldr failed for (\\S+)").matcher(logText);
      if (m.find()) {
        tableName = m.group(1);
      } else {
        java.util.regex.Matcher m2 = java.util.regex.Pattern.compile("Table \\(re\\)created: \\S+\\.(\\S+)").matcher(logText);
        if (m2.find()) {
          tableName = m2.group(1);
        }
      }
    }
  } catch (Exception e) {
    // best effort - only used for the log message below
  }

  logError("Table " + tableName + " failed in migrate_table.hpl - check the log above for details.");
  setErrors(getErrors() + 1);

  if (failFast) {
    throw new HopException("Aborting gather_table_info.hpl: table " + tableName
      + " failed and fail_fast is true - see config.yaml to change this behavior.");
  }

  return true;
}
